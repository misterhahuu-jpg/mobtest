# Telegram bot token from @BotFather
BOT_TOKEN=

# Public URL Railway assigns to this service, e.g. https://tg-task-app-production.up.railway.app
# Leave empty locally to run the bot in polling mode instead of webhook mode
WEBAPP_URL=

# Provided automatically by Railway's Postgres plugin - copy its value locally for dev
DATABASE_URL=

# Points awarded per completed task
TASK_REWARD=10

# AdsGram Task block id (format: task-xxx) from https://partner.adsgram.ai
VITE_ADSGRAM_BLOCK_ID=task-000
